{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    {
      "foreground": "#b4b7bc",
      "token": "variable.parameter.function"
    },
    {
      "foreground": "#3b414d",
      "token": "comment, punctuation.definition.comment"
    },
    {
      "foreground": "#b4b7bc",
      "token": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array"
    },
    {
      "foreground": "#b4b7bc",
      "token": "keyword.operator"
    },
    {
      "foreground": "#727780",
      "token": "keyword"
    },
    {
      "foreground": "#777b84",
      "token": "variable"
    },
    {
      "foreground": "#686d77",
      "token": "entity.name.function, meta.require, support.function.any-method"
    },
    {
      "foreground": "#9ca0a6",
      "token": "support.class, entity.name.class, entity.name.type.class"
    },
    {
      "foreground": "#f0f1f3",
      "token": "meta.class"
    },
    {
      "foreground": "#686d77",
      "token": "keyword.other.special-method"
    },
    {
      "foreground": "#727780",
      "token": "storage"
    },
    {
      "foreground": "#858991",
      "token": "support.function"
    },
    {
      "foreground": "#8f929a",
      "token": "string, constant.other.symbol, entity.other.inherited-class"
    },
    {
      "foreground": "#9599a0",
      "token": "constant.numeric"
    },
    {
      "foreground": "#9599a0",
      "token": "constant"
    },
    {
      "foreground": "#777b84",
      "token": "entity.name.tag"
    },
    {
      "foreground": "#9599a0",
      "token": "entity.other.attribute-name"
    },
    {
      "foreground": "#686d77",
      "token": "entity.other.attribute-name.id, punctuation.definition.entity"
    },
    {
      "foreground": "#727780",
      "token": "meta.selector"
    },
    {
      "foreground": "#686d77",
      "token": "markup.heading punctuation.definition.heading, entity.name.section"
    },
    {
      "foreground": "#9599a0",
      "token": "keyword.other.unit"
    },
    {
      "foreground": "#9ca0a6",
      "fontStyle": "bold",
      "token": "markup.bold, punctuation.definition.bold"
    },
    {
      "foreground": "#727780",
      "fontStyle": "italic",
      "token": "markup.italic, punctuation.definition.italic"
    },
    {
      "foreground": "#8f929a",
      "token": "markup.raw.inline"
    },
    {
      "foreground": "#777b84",
      "token": "string.other.link, punctuation.definition.string.end.markdown"
    },
    {
      "foreground": "#9599a0",
      "token": "meta.link"
    },
    {
      "foreground": "#777b84",
      "token": "markup.list"
    },
    {
      "foreground": "#9599a0",
      "token": "markup.quote"
    },
    {
      "foreground": "#b4b7bc",
      "token": "meta.separator"
    },
    {
      "foreground": "#8f929a",
      "token": "markup.inserted"
    },
    {
      "foreground": "#777b84",
      "token": "markup.deleted"
    },
    {
      "foreground": "#727780",
      "token": "markup.changed"
    },
    {
      "foreground": "#858991",
      "token": "constant.other.color"
    },
    {
      "foreground": "#858991",
      "token": "string.regexp"
    },
    {
      "foreground": "#858991",
      "token": "constant.character.escape"
    },
    {
      "foreground": "#727780",
      "token": "punctuation.section.embedded, variable.interpolation"
    },
    {
      "foreground": "#f0f1f3",
      "token": "invalid.illegal"
    },
    {
      "foreground": "#111827",
      "token": "invalid.broken"
    },
    {
      "foreground": "#f0f1f3",
      "token": "invalid.deprecated"
    },
    {
      "foreground": "#f0f1f3",
      "token": "invalid.unimplemented"
    }
  ],
